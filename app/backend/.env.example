# Generate a private random key locally; never commit .env.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Use require or verify-full as appropriate for your remote PostgreSQL provider.
POSTGRES_SSLMODE=prefer
