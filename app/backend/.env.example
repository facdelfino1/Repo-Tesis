# Generate a private random key locally; never commit .env.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Use require or verify-full as appropriate for your remote PostgreSQL provider.
POSTGRES_SSLMODE=prefer
# Optional isolated test database name. Django creates/drops it; never use the development database name.
POSTGRES_TEST_DB=
# HTTPS cookies default to secure when DJANGO_DEBUG=false. Local HTTP: use DEBUG=true.
# DJANGO_SESSION_COOKIE_SECURE=true
# DJANGO_CSRF_COOKIE_SECURE=true
# Leave empty for same-origin requests; explicitly list trusted HTTPS origins when needed.
DJANGO_CSRF_TRUSTED_ORIGINS=
# Password recovery: trusted API origin, never derived from a client Host header.
PASSWORD_RESET_BASE_URL=http://localhost:8000
# Local development only; production: django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@localhost
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
